# Site (set production URL on Vercel, e.g. https://your-domain.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key — safe for browser client when you add reads/auth
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role / secret key — SERVER ONLY; used for inquiries + newsletter inserts
SUPABASE_SECRET_KEY=

# Resend (contact form)
RESEND_API_KEY=
CONTACT_EMAIL=
